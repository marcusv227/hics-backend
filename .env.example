PORT=3000
NODE_ENV=development

# App database (separate from the RAG/pgvector database used by n8n)
DATABASE_URL="postgresql://hics:hics_password@localhost:5433/hics_db?schema=public"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# n8n integration
N8N_WEBHOOK_CHAT_URL="https://your-n8n-instance/webhook/hics-chat"
N8N_WEBHOOK_TIMEOUT_MS=15000

# Swagger docs basic auth (only enforced when NODE_ENV=production)
SWAGGER_USER="admin"
SWAGGER_PASSWORD="change-me"
